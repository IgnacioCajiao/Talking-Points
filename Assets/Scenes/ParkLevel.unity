    - target: {fileID: 4731402326743390885, guid: 03bb3279d6466e44b8f7349f293b5128, type: 3}
      propertyPath: m_text
      value: "Think of the atmosphere like a sponge. Air holds about 4% more water
        vapor for each additional degree Fahrenheit increase in temperature (that\u2019s
        about 7% per degree Celsius). The physical law that explains this relationship
        is known as the Clausius-Clapyron relation.\r\n"
      objectReference: {fileID: 0}
